<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- MINIMIZED FLOATING BUBBLE (Visible when hidden/minimized) -->
    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_minimized_bubble"
        android:elevation="18dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvBubbleIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvBubbleDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:text="●"
            android:textColor="#00F5D4"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- EXPANDED COMPACT HUD CARD -->
    <LinearLayout
        android:id="@+id/dockContainer"
        android:layout_width="142dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_hud"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="7dp"
        android:visibility="visible">

        <!-- HEADER: STATUS BADGE + MINIMIZE / HIDE BUTTON -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_status_badge"
                android:gravity="center"
                android:paddingVertical="3dp"
                android:text="⚪ KAPTOR • ESPERA"
                android:textColor="#94a3b8"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <!-- MINIMIZE / HIDE BUTTON -->
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_icon"
                android:gravity="center"
                android:text="━"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 1: TOTAL KM & TOTAL MIN (ROUTE SUMMARY) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_subpanel"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/tvTotalKm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0.0 km"
                android:textColor="#00F5D4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•"
                android:textColor="#475569"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvTotalMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 min"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="3dp"
            android:background="#251E293B" />

        <!-- ROW 2: ORIGIN / PICKUP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Recogida"
                android:textColor="#94a3b8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tvOriginDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 km"
                android:textColor="#cbd5e1"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 3: RATE PER KM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💵 $/Km"
                android:textColor="#94a3b8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tvPerKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#00F5D4"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 4: RATE PER MINUTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱️ $/Min"
                android:textColor="#94a3b8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tvPerMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#f8fafc"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 5: FAIR PRICE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💡 Justa"
                android:textColor="#94a3b8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tvFairPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#FFBE0B"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="3dp"
            android:background="#251E293B" />

        <!-- ROW 6: BALANCE / FALTANTE / SOBRANTE -->
        <TextView
            android:id="@+id/tvDiffPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="BALANCE: --"
            android:textColor="#94a3b8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
